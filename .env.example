# Path to the JSON config file declaring sources, tiers, thresholds, and the arbiter
PEER_REVIEW_CONFIG=./peer-review.config.json

# Per-source request timeout (ms)
PEER_TIMEOUT_MS=120000

# Hard overall deadline for a peer_review or query_peer call (ms) — a degraded result is returned on expiry.
# MUST stay strictly below PEER_REVIEW_CALLER_TIMEOUT_MS (below).
PEER_REVIEW_DEADLINE_MS=280000

# Declared MCP client tool-call timeout (ms) — the ceiling this server assumes.
# The harness registration owner sets the real value (Quinn derives its client timeout from
# the deadline plus transport margin; it is omp's per-server `timeout` key). If the deadline is
# not strictly below this, the server warns at startup and reports the mismatch on list_peers
# and failure envelopes — above it, the caller abandons the call and reports only its own
# generic timeout, so no verdict anyone computed is read.
PEER_REVIEW_CALLER_TIMEOUT_MS=300000

# Max output tokens injected server-side into every peer call
PEER_MAX_OUTPUT_TOKENS=8192

# TTL (seconds) for credentials minted via apiKeyCommand
PEER_CREDENTIAL_TTL_S=3000

# pino log level (logs go to stderr; stdout is reserved for the MCP stdio transport)
LOG_LEVEL=info

# API keys are referenced by env-var NAME from the config file's apiKeyEnv fields, e.g.:
# NOTE: Use these for debug and development only, these are typically issued in your MCP config file instead of here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
